# =============================================================================
# Cancelaciones AI — variables de entorno (SOLO servidor)
# =============================================================================
# Copiar a `.env.local` (gitignored) y completar.
#
# IMPORTANTE: ninguna variable lleva prefijo VITE_. En este proyecto NO existe
# ninguna variable pública para el navegador: el cliente nunca habla con
# InsForge ni con OpenRouter, todo pasa por /api/* en el servidor.
# Si alguna vez aparece un `VITE_*`, es un bug de diseño (fuga de secreto).
#
# Todas las variables de este archivo se leen y validan en `src/server/env.ts`.
# Si falta una obligatoria, el servidor falla al arrancar con
# "[env] Falta la variable de entorno <NOMBRE>".
# =============================================================================


# -----------------------------------------------------------------------------
# InsForge — base de datos, autenticación y almacenamiento
# -----------------------------------------------------------------------------

# OBLIGATORIA. URL base del proyecto InsForge. Sin barras finales.
INSFORGE_BASE_URL=https://4pw4jdzv.us-west.insforge.app

# OBLIGATORIA. Anon key del proyecto InsForge. Da acceso al rol `anon` y, con
# la cookie de sesión, al rol `authenticated` (que es el que aplica RLS).
# No es un secreto de administración, pero tampoco se expone al navegador:
# todas las consultas pasan por el servidor.
INSFORGE_ANON_KEY=

# REQUERIDA. Clave administrativa de InsForge; solo se usa en el servidor.
# La aplicación no requiere inicio de sesión y opera sobre casos compartidos.
INSFORGE_API_KEY=

# OPCIONAL. Bucket de InsForge Storage donde viven los binarios de las
# evidencias. Default: `evidencias`.
# La key dentro del bucket la compone el servidor como
# `{caseId}/{uuid}-{sanitizedFilename}`; el nombre del archivo nunca controla
# la ruta. El bucket NO lo crea esta aplicación: se crea con la CLI de
# InsForge (`insforge storage buckets`).
INSFORGE_STORAGE_BUCKET=evidencias


# -----------------------------------------------------------------------------
# IA — OpenRouter (único proveedor de IA del producto)
# -----------------------------------------------------------------------------

# OBLIGATORIA. API key de OpenRouter. Solo la usa el servidor.
OPENROUTER_API_KEY=

# OBLIGATORIA. Modelo principal. Debe existir en el catálogo OpenRouter y tener
# modalidad adecuada; GET /api/health/ai muestra las capacidades detectadas.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# OPCIONAL. Respaldo estable y multimodal, distinto al primario. Evita modelos
# preview/experimental para producción salvo aprobación explícita.
OPENROUTER_FALLBACK_MODEL=

# OPCIONAL. Presupuesto operativo máximo de salida, validado contra el límite
# seguro del proveedor y el máximo de salida publicado por OpenRouter.
# Default: 8192; máximo operativo de los perfiles actuales: 16384.
AI_MAX_OUTPUT_TOKENS=8192


# -----------------------------------------------------------------------------
# Audio — AssemblyAI (SOLO transcripción; no decide negocio)
# -----------------------------------------------------------------------------

# OPCIONAL. Requerida únicamente para subir evidencias de audio. Sin ella, los
# PDFs, imágenes y textos siguen funcionando; un audio subido sin esta variable
# queda en estado ERROR con categoría TRANSCRIPTION_ERROR.
# No hay webhooks: la transcripción se refresca bajo demanda (polling del
# cliente contra GET /api/cases/:caseId/evidence y GET /api/cases/:caseId/audit).
ASSEMBLYAI_API_KEY=


# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

# OPCIONAL. Origen público de la app.
#   · se envía como `HTTP-Referer` a OpenRouter,
#   · decide si las cookies de sesión llevan `Secure` (true si empieza por https://).
# Default en desarrollo: http://localhost:5173. En Vercel: la URL del despliegue.
APP_URL=http://localhost:5173

# OPCIONAL. Límite de tamaño por evidencia, en bytes. Default: 4194304 (4 MB).
# Se mantiene por debajo del límite de body de Vercel Functions (4.5 MB);
# subirlo hace que las subidas grandes fallen con HTTP 413 en la plataforma
# antes de llegar a la aplicación.
MAX_EVIDENCE_BYTES=4194304

# OPCIONAL. Milisegundos de espera máxima al refrescar transcripciones antes de
# auditar. Default: 25000 (25 s).
# Acota el tiempo que una Function puede quedar esperando a AssemblyAI; si se
# agota, el caso responde 202 con las evidencias aún pendientes y el cliente
# vuelve a intentarlo.
TRANSCRIPTION_POLL_TIMEOUT_MS=25000

# OPCIONAL. Timeout por intento de llamada a OpenRouter, en milisegundos.
# Default: 60000. Cada intento usa min(AI_TIMEOUT_MS, tiempo restante del
# deadline global), por lo que varios retries no exceden el presupuesto total.
AI_TIMEOUT_MS=60000

# OPCIONAL. Presupuesto total de auditoría dentro de la Function de Vercel.
# Default: 240000 (4 min), compatible con maxDuration=300.
TOTAL_AUDIT_TIMEOUT_MS=240000

# OPCIONAL. Cuándo considerar abandonada una auditoría RUNNING para polling.
# Debe ser mayor que TOTAL_AUDIT_TIMEOUT_MS para no matar una request legítima.
# Default: 600000 (10 min).
AUDIT_STALE_AFTER_MS=600000

# OPCIONALES. Límites agregados del expediente enviado a IA. Evitan prompts
# absurdos aunque cada archivo individual cumpla MAX_EVIDENCE_BYTES.
MAX_EVIDENCE_COUNT=50
MAX_AUDIT_TEXT_CHARS=180000
MAX_AUDIT_TEXT_CHARS_PER_EVIDENCE=40000
MAX_AUDIT_MULTIMODAL_BYTES=16777216


# =============================================================================
# Referencia rápida
# =============================================================================
#   OBLIGATORIAS: INSFORGE_BASE_URL, INSFORGE_ANON_KEY,
#                 OPENROUTER_API_KEY, OPENROUTER_MODEL
#   OPCIONALES:   INSFORGE_API_KEY, INSFORGE_STORAGE_BUCKET,
#                 OPENROUTER_FALLBACK_MODEL, AI_MAX_OUTPUT_TOKENS,
#                 ASSEMBLYAI_API_KEY, APP_URL,
#                 MAX_EVIDENCE_BYTES, TRANSCRIPTION_POLL_TIMEOUT_MS,
#                 AI_TIMEOUT_MS, TOTAL_AUDIT_TIMEOUT_MS,
#                 AUDIT_STALE_AFTER_MS, MAX_EVIDENCE_COUNT,
#                 MAX_AUDIT_TEXT_CHARS, MAX_AUDIT_TEXT_CHARS_PER_EVIDENCE,
#                 MAX_AUDIT_MULTIMODAL_BYTES
#   PROHIBIDAS:   cualquier variable con prefijo VITE_ o NEXT_PUBLIC_
# =============================================================================
