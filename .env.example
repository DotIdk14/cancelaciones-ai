# =============================================================================
# Variables de entorno — Cancelaciones AI
# =============================================================================
# TODAS estas variables son server-side. No agregar prefijos VITE_ ni
# NEXT_PUBLIC_ a ninguna de ellas; el build falla si detecta una fuga.
# Copiar este archivo a .env.local y completar los valores.
# =============================================================================

# -----------------------------------------------------------------------------
# InsForge (obligatorias)
# -----------------------------------------------------------------------------
INSFORGE_BASE_URL=https://4pw4jdzv.us-west.insforge.app
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# Bucket de Storage donde se guardan los binarios de las evidencias.
# Default: evidencias
INSFORGE_STORAGE_BUCKET=evidencias

# -----------------------------------------------------------------------------
# OpenRouter (obligatorias)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Modelo de fallback. Debe ser distinto de OPENROUTER_MODEL.
# OPENROUTER_FALLBACK_MODEL=

# -----------------------------------------------------------------------------
# AssemblyAI (opcional — solo si se procesa audio)
# -----------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=

# -----------------------------------------------------------------------------
# Aplicación / límites (server-side, opcionales)
# -----------------------------------------------------------------------------
# Origen propio. En Vercel, si no se define, se usa https://<VERCEL_URL>.
# APP_URL=https://app.ejemplo.com

# Límite de subida por evidencia en bytes (default 4 MB).
# MAX_EVIDENCE_BYTES=4194304

# Tiempo máximo de espera al refrescar transcripciones antes de auditar (ms).
# TRANSCRIPTION_POLL_TIMEOUT_MS=25000

# Cantidad máxima de evidencias por caso (default 50, max 100).
# MAX_EVIDENCE_COUNT=50

# Tamaño máximo del texto agregado enviado a la IA (default 180000).
# MAX_AUDIT_TEXT_CHARS=180000

# Tamaño máximo de texto por evidencia (default 40000).
# MAX_AUDIT_TEXT_CHARS_PER_EVIDENCE=40000

# Tamaño máximo del contenido multimodal (imágenes/PDF nativos) en bytes.
# Default 16 MB.
# MAX_AUDIT_MULTIMODAL_BYTES=16777216

# -----------------------------------------------------------------------------
# OpenRouter / timeouts (server-side, opcionales)
# -----------------------------------------------------------------------------
# Timeout por intento de llamada a OpenRouter (default 60000, max 290000).
# AI_TIMEOUT_MS=60000

# Deadline total de una auditoría (default 240000, max 295000).
# TOTAL_AUDIT_TIMEOUT_MS=240000

# Tiempo tras el cual una auditoría RUNNING se considera abandonada (default 600000).
# AUDIT_STALE_AFTER_MS=600000

# Presupuesto de tokens de salida (default 16384, max 16384).
# AI_MAX_OUTPUT_TOKENS=16384

# Timeout de cada llamada HTTP a AssemblyAI (default 60000, max 280000).
# Sin esto, un submit que nunca responde deja la Function colgada y la evidencia
# en UPLOADED para siempre.
# ASSEMBLYAI_REQUEST_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------- 
# Cuotas (server-side, opcional pero recomendado)
# -----------------------------------------------------------------------------
# Clave HMAC con la que se hashean correo, IP y user_id antes de persistirlos en
# request_admissions. La base nunca ve el sujeto en claro.
#
# Si se omite, se usa INSFORGE_API_KEY como clave de HMAC. Funciona, pero implica
# que rotar la clave de InsForge invalida silenciosamente todas las cuotas: los
# hashes viejos dejan de coincidir con los nuevos y el historial de cuota se
# reinicia. Definir una clave propia evita esa acoplamiento.
# QUOTA_HMAC_KEY=

# Límites por operación (los valores viven en migrations/20261003000000_paid_admissions.sql;
# se documentan aquí solo como referencia).
#   login por correo : 5 intentos / 15 min
#   login por IP     : 10 intentos / 15 min

# -----------------------------------------------------------------------------
# Revisión humana / comparación (server-side, opcionales)
# -----------------------------------------------------------------------------
# Máximo de reintentos de una comparación (default 3, max 20).
# COMPARISON_MAX_RETRIES=3

# Backoff mínimo entre reintentos de comparación en ms (default 5000).
# COMPARISON_RETRY_MIN_BACKOFF_MS=5000
